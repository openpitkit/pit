# Risk Playground shortcuts. The same recipes back local work and CI.

set windows-shell := ["cmd.exe", "/c"]

repo_dir := justfile_directory() / "../../.."
node_dir := env_var_or_default("PIT_NODE_DIR", repo_dir / "target" / "node")
node_bin_dir := if os_family() == "windows" { node_dir } else { node_dir / "bin" }
path_separator := if os_family() == "windows" { ";" } else { ":" }
export PATH := node_bin_dir + path_separator + env_var("PATH")

# Install the locked dependencies; the engine links to the local bindings/js.
install:
    npm ci --no-audit --no-fund

# Rebuild the local JS binding and serve the playground on a dev server.
run:
    just --justfile "{{ repo_dir }}/justfile" build-js
    npm run dev

# Test, type-check, and bundle against the local build of bindings/js.
check:
    npm test
    npm run build
