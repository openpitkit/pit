{
  "name": "openpit",
  "version": "@OPENPIT_VERSION@",
  "description": "C++17 binding for the OpenPit pre-trade risk SDK",
  "homepage": "https://openpit.dev",
  "license": "Apache-2.0",
  "supports": "((linux | osx) & (x64 | arm64)) | (windows & x64 & !uwp & !mingw)",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ]
}
